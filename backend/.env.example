# Development-only example values. Use a strong, unique SECRET_KEY locally.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./swampspace.db
SECRET_KEY=
LOCAL_AUTH_ENABLED=true
CORS_ORIGINS=["http://localhost:5173"]
SESSION_LIFETIME_MINUTES=10080
VERIFICATION_TOKEN_LIFETIME_MINUTES=30
EMAIL_DELIVERY=file
EMAIL_OUTBOX_PATH=./development-email-outbox.jsonl
